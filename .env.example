# ─── Syllabyte — Local Development Environment ───────────────────────────────
#
# Copy this file to .env and fill in the values.
# The frontend (.env) and backend (.env) share these variables.
#
# For local dev, create TWO .env files:
#   - artifacts/syllabyte/.env   (Vite picks this up automatically)
#   - artifacts/api-server/.env  (load with dotenv or set in your shell)
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (get from your Supabase project → Settings → API) ───────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend port (optional — defaults to 3001) ────────────────────────────────
# PORT=3001

# ── Frontend port (optional — defaults to 5173) ───────────────────────────────
# PORT=5173

# ── Supabase DB connection (for the API server direct DB access) ──────────────
# Build the connection string from:
#   host:     db.<your-project-ref>.supabase.co
#   port:     5432
#   user:     postgres
#   password: your-db-password (SUPABASE_DB_PASSWORD from Supabase dashboard)
#   database: postgres
SUPABASE_DB_PASSWORD=your-db-password-here
